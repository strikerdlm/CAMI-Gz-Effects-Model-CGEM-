{
  "name": "g-effects-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "G-Effects Safety Dashboard - Aerospace physiology visualization and G-LOC prediction",
  "author": "Dr. Diego Malpica",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "cd .. && python3 scripts/export_maneuvers_json.py",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "regen:maneuvers": "cd .. && python3 scripts/export_maneuvers_json.py",
    "generate:openapi": "cd .. && python3 scripts/export_openapi.py",
    "generate:types": "openapi-typescript ../docs/api/openapi.json -o src/services/generated/api.ts",
    "generate:contracts": "npm run generate:openapi && npm run generate:types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "echarts-gl": "^2.0.9",
    "framer-motion": "^12.30.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
